{
  "name": "interview-assistant-saas",
  "version": "0.2.0",
  "description": "Cloud SaaS for the Interview Assistant: Electron desktop client + Node backend (auth, credits, realtime session gateway) sharing a pure domain core.",
  "private": true,
  "type": "module",
  "author": "",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @interview-assistant/desktop",
    "build": "npm run build --workspace @interview-assistant/desktop",
    "build:backend": "npm run build --workspace @interview-assistant/backend --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
