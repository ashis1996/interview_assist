# Backend environment configuration. Copy to `.env` and fill in.
# Every value here is server-side only and must NEVER ship in the desktop client.
# Do NOT commit `.env` (it is gitignored).

# ---------------------------------------------------------------------------
# LOCAL development (no Supabase, no cost). Auth + credits are bypassed, so the
# backend never contacts Supabase — only a local Postgres is needed.
# ---------------------------------------------------------------------------
APP_ENVIRONMENT=local
PORT=8787

# Local Postgres (from `docker compose up -d`, or a native install). Apply
# packages/backend/db/schema.sql first (docker-compose does this automatically).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/interview_assistant

# Provider keys (put your real keys here, NOT in chat or source control).
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Optional, for other providers:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=        # https://console.groq.com/keys (OpenAI-compatible, very fast)

# Provider selection for local testing.
# DEFAULT_LLM_PROVIDER: claude | openai | gemini | groq
DEFAULT_STT_PROVIDER=deepgram
DEFAULT_LLM_PROVIDER=gemini
# Override the model per provider, e.g.:
# DEFAULT_LLM_MODEL=gemini-2.5-flash
# DEFAULT_LLM_MODEL=llama-3.3-70b-versatile   # (groq, balanced)
# DEFAULT_LLM_MODEL=llama-3.1-8b-instant      # (groq, lowest latency)

# Credit knobs (irrelevant in local/dev since enforcement is bypassed).
LOW_CREDIT_THRESHOLD=5
CREDITS_PER_STT_MINUTE=1
CREDITS_PER_LLM_TOKEN=0.0001

# ---------------------------------------------------------------------------
# CLOUD environments (dev / pre-prod / prod). Set these on the hosted backend.
# As of the dev release, dev ENFORCES auth + credits (it no longer bypasses):
#   - auth is verified via Supabase JWKS (derived from SUPABASE_URL)
#   - credits are enforced for regular accounts (pre-session check + hard stop)
#   - superusers bypass credit enforcement per-account via accounts.is_superuser
# dev/pre-prod/prod all use a Supabase-hosted Postgres. Only `local` bypasses
# auth + credits; unknown environments fail safe to enforced.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# (SUPABASE_JWKS_URL / SUPABASE_JWT_ISSUER are derived from SUPABASE_URL if unset)
#
# Optional: comma-separated emails (incl. the owner) auto-flagged is_superuser
# on first sign-in. Owner-managed thereafter via the Supabase Table Editor.
# SUPERUSER_BOOTSTRAP_EMAILS=owner@example.com
